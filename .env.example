# 🛡️ AI Guard Configuration

# Camera Settings
# 0 = default webcam, or RTSP URL e.g. rtsp://username:password@192.168.1.100:554/stream1, or path to .mp4
CAMERA_SOURCE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# Detection Settings
# Models: yolov8n.pt (fastest), yolov8s.pt, yolov8m.pt
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.5
DEVICE=cpu

# Zone & Alert Settings
ZONE_CONFIG_PATH=data/zones/default_zone.json
ALERT_COOLDOWN_SECONDS=30
SAVE_ALERT_SCREENSHOTS=true
SCREENSHOT_DIR=data/alerts

# Email Notifications (Optional - leaves empty to disable)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENT=

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
